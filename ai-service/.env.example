AI_SERVICE_NAME=ai-prompt-service
AI_VERSION=0.1.0
AI_API_PREFIX=/v1
AI_ENVIRONMENT=dev
AI_INTERNAL_API_KEY=change-me

RAG_DATABASE_URL=postgresql+asyncpg://rag:rag_password@localhost:5433/rag
RAG_EMBEDDING_MODEL=qwen3-embedding:0.6b
RAG_EMBEDDING_DIM=1024
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_RETRIEVE_TOP_K=20
RAG_RERANK_TOP_K=5
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_EVAL_DATASET_DIR=rag-eval
